{
  "name": "slayer-ui",
  "version": "0.1.0",
  "description": "Slayer UI — a World of Warcraft Titan Reforged addon with Demon Slayer-inspired UI.",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node scripts/build-addon.mjs --clean",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/generate-spell-effect-manifest.mjs && tstl -p tsconfig.json && node scripts/build-addon.mjs",
    "dev": "node scripts/dev.mjs",
    "watch": "tstl -p tsconfig.json --watch",
    "package": "npm run build && node scripts/build-addon.mjs --zip",
    "install:addon": "npm run build && node scripts/build-addon.mjs --install"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "typescript-to-lua": "^1.36.0"
  }
}
