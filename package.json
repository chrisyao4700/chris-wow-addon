{
  "name": "chris-wow-addon",
  "version": "0.1.0",
  "description": "A World of Warcraft Titan Reforged addon scaffold built with TypeScript, Node.js, and CurseForge-compatible packaging.",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node scripts/build-addon.mjs --clean",
    "typecheck": "tsc --noEmit",
    "build": "tstl -p tsconfig.json && node scripts/build-addon.mjs",
    "watch": "tstl -p tsconfig.json --watch",
    "package": "npm run build && node scripts/build-addon.mjs --zip",
    "install:addon": "npm run build && node scripts/build-addon.mjs --install"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "typescript-to-lua": "^1.36.0"
  }
}
